{
  "name": "educare-backend",
  "version": "2.0.0",
  "private": true,
  "description": "EduCare API — classes, assignments, AI tutor, study tools",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "test": "node --test --test-timeout=300000 \"test/*.test.js\"",
    "smoke:ai": "node --env-file=.env scripts/ai-smoke.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "prisma": "6.19.3"
  }
}
