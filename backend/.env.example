# ---- EduCare API ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (any localhost port is allowed in development)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (Atlas or a local replica set — Prisma needs a replica set)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/educare

# Auth — use a long random string (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Gemini — all LLM calls happen server-side. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model, then fallbacks tried in order when a model is rate-limited or overloaded
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite

# File storage: Cloudinary is used when all three are set; otherwise files are stored in ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: absolute base URL for locally stored uploads (only needed when the
# frontend is served from a different origin than the API in production)
PUBLIC_URL=
